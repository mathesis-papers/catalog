{
  "schema": "omega.display-monitor.v1",
  "repository": "mathesis-papers/catalog",
  "checks": [
    {
      "id": "home",
      "url": "https://papers.trureturing.org/",
      "owner": "mathesis-papers/catalog",
      "kind": "html",
      "contains": "Mathesis"
    },
    {
      "id": "material-index",
      "url": "https://papers.trureturing.org/materials-index.json",
      "owner": "mathesis-papers/catalog",
      "kind": "materials",
      "equals": {
        "schema": "mathesis.materials-index.v1"
      },
      "required": [
        "entries",
        "generated_at"
      ],
      "nonempty": "entries"
    },
    {
      "id": "publisher-completion",
      "owner": "mathesis-papers/catalog",
      "kind": "json",
      "url": "https://api.github.com/repos/mathesis-papers/catalog/actions/workflows/publish.yml/runs?status=completed&event=schedule&per_page=1",
      "equals": {
        "workflow_runs.0.conclusion": "success"
      },
      "timestamp": "workflow_runs.0.updated_at",
      "max_age_seconds": 10800
    }
  ],
  "browser": [
    {
      "id": "reader",
      "url": "https://papers.trureturing.org/",
      "owner": "mathesis-papers/catalog"
    }
  ],
  "targets": {
    "mathesis-papers/catalog": {
      "branch": "main",
      "paths": [
        "scripts/collection.py",
        "scripts/paper_products.py",
        "scripts/verify_factory.py",
        "scripts/hosted_materials.py",
        "scripts/material_policy.py",
        "tests/test_hosted_materials.py",
        "tests/test_factory.py",
        "tests/test_collection.py"
      ],
      "verify": [
        [
          "python3",
          "scripts/check_monitor_repair.py"
        ]
      ],
      "auto_merge": true,
      "github_service": "display-catalog-github"
    },
    "the-omega-institute/trureturing-outreach-engine": {
      "branch": "main",
      "paths": [
        "managed/mathesis_delivery.py",
        "scripts/short_notes/service.py",
        "scripts/short_notes/workflow.py"
      ],
      "verify": [
        [
          "python3",
          "-m",
          "compileall",
          "-q",
          "managed",
          "scripts/short_notes"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "managed/tests"
        ],
        [
          "python3",
          "-m",
          "unittest",
          "discover",
          "-s",
          "scripts/short_notes",
          "-p",
          "test_*.py"
        ]
      ],
      "auto_merge": false,
      "github_service": "display-outreach-github"
    }
  },
  "publisher_login": "AlyciaBHZ"
}
